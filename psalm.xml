<?xml version="1.0"?>
<psalm
    errorLevel="3"
    phpVersion="8.3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <pluginClass class="Be\PsalmPlugin\Plugin" />
    </plugins>

    <issueHandlers>
        <!--
            Be Framework loads classes via #[Be] attributes and constructs them via
            reflection in Becoming. Psalm's reachability analysis cannot see these
            dynamic call paths, so the stock unused-* rules fire false positives on
            valid framework patterns. Scopes are narrowed to the framework-reflected
            directories only; src/Exception is intentionally NOT suppressed so that
            orphaned exception classes are still surfaced.
        -->
        <UnusedClass>
            <errorLevel type="suppress">
                <directory name="src/Input" />
                <directory name="src/Module" />
                <directory name="src/Semantic" />
            </errorLevel>
        </UnusedClass>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src/Becoming" />
                <directory name="src/Final" />
            </errorLevel>
        </PossiblyUnusedMethod>
        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <directory name="src/Final" />
            </errorLevel>
        </PossiblyUnusedProperty>
        <UnusedParam>
            <errorLevel type="suppress">
                <directory name="src/Semantic" />
            </errorLevel>
        </UnusedParam>
    </issueHandlers>
</psalm>
